<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SunlitAnimate.Controls"
        x:Class="SunlitAnimate.MainWindow"
        Title="Sunlit Animate"
        Width="1200"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        Background="#202027">
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="190,*,220">
    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#292932" Padding="14,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="SUNLIT" FontSize="13" FontWeight="Bold" Foreground="#C7B5FF" />
          <TextBlock Text="ANIMATE" FontSize="13" FontWeight="Bold" Foreground="#F4F0FF" />
          <Border Width="1" Height="20" Background="#494952" Margin="6,0" />
          <TextBlock x:Name="ProjectNameText" Text="Untitled Animation" VerticalAlignment="Center" Foreground="#E6E2F0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="New" Click="NewProject_Click" />
          <Button Content="Open" Click="OpenProject_Click" />
          <Button Content="Save" Click="SaveProject_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="#25252D" Padding="12">
      <StackPanel Spacing="14">
        <TextBlock Text="TOOLS" FontWeight="Bold" FontSize="11" Foreground="#AAA6B8" />
        <Button Content="Brush" Click="Brush_Click" HorizontalContentAlignment="Left" />
        <Button Content="Eraser" Click="Eraser_Click" HorizontalContentAlignment="Left" />
        <Button Content="Undo" Click="Undo_Click" HorizontalContentAlignment="Left" />
        <Button Content="Redo" Click="Redo_Click" HorizontalContentAlignment="Left" />
        <Button Content="Clear frame" Click="ClearFrame_Click" HorizontalContentAlignment="Left" />
        <Border Height="1" Background="#41414A" Margin="0,4" />
        <TextBlock Text="BRUSH COLOUR" FontSize="11" Foreground="#AAA6B8" />
        <TextBox x:Name="ColorInput" Text="#252027" Watermark="#RRGGBB" />
        <TextBlock Text="BRUSH SIZE" FontSize="11" Foreground="#AAA6B8" />
        <NumericUpDown x:Name="BrushSizeInput" Minimum="1" Maximum="80" Value="4" />
        <TextBlock Text="Canvas: 1280 × 720" FontSize="11" Foreground="#AAA6B8" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Background="#1B1B21" Padding="18">
      <Grid>
        <Border Background="#111116" Padding="10" HorizontalAlignment="Center" VerticalAlignment="Center">
          <controls:DrawingSurface x:Name="CanvasSurface" Width="800" Height="450" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="2" Background="#25252D" Padding="12">
      <StackPanel Spacing="12">
        <TextBlock Text="PROJECT" FontWeight="Bold" FontSize="11" Foreground="#AAA6B8" />
        <TextBlock Text="Frames per second" FontSize="12" />
        <NumericUpDown x:Name="FpsInput" Minimum="1" Maximum="60" Value="12" />
        <TextBlock Text="Project format" FontSize="12" />
        <TextBlock Text=".sanp — Sunlit Animate Project" FontSize="11" Foreground="#AAA6B8" TextWrapping="Wrap" />
        <Border Height="1" Background="#41414A" Margin="0,4" />
        <TextBlock Text="STATUS" FontWeight="Bold" FontSize="11" Foreground="#AAA6B8" />
        <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#292932" Padding="12,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="＋ Frame" Click="AddFrame_Click" />
          <Button Content="Duplicate" Click="DuplicateFrame_Click" />
          <Button Content="Delete" Click="DeleteFrame_Click" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="FRAME" Foreground="#AAA6B8" VerticalAlignment="Center" FontSize="11" />
          <TextBlock x:Name="FrameNumberText" Text="1 / 1" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="Previous" Click="PreviousFrame_Click" />
          <Button Content="Next" Click="NextFrame_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
